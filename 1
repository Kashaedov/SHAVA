            <button
              onClick={() => setActiveTab('profile')}
              className={`px-3.5 py-2 rounded-xl transition flex items-center gap-1.5 whitespace-nowrap ${
                activeTab === 'profile' ? 'bg-[#F97316] text-white shadow-md font-bold' : 'text-[#FDFBF7]/80 hover:text-white hover:bg-[#1A4332]'
              }`}
            >
              <User className="w-4 h-4" /> Кабинет
            </button>
          </nav>

          {/* Панель пользователя и Режим доступа */}
          <div className="flex items-center gap-3">
            <button
              onClick={() => setIsPublicMode(!isPublicMode)}
              className={`flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-xl border transition font-medium ${
                isPublicMode 
                  ? 'bg-amber-500/10 text-amber-400 border-amber-500/30' 
                  : 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30'
              }`}
              title="Переключить режим видимости"
            >
              {isPublicMode ? <Eye className="w-3.5 h-3.5" /> : <Lock className="w-3.5 h-3.5" />}
              <span>{isPublicMode ? 'Публичный режим' : 'Закрытый Клуб'}</span>
