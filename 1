// Функция расчёта среднего арифметического категории
const calcCategoryAvg = (obj) => {
  if (!obj) return 0;
  const vals = Object.values(obj);
  if (vals.length === 0) return 0;
  return vals.reduce((a, b) => a + Number(b), 0) / vals.length;
};

export default function App() {
  // Состояние с хранением в localStorage
  const [venues, setVenues] = useState(() => {
    const saved = localStorage.getItem('shava_venues_v2');
    return saved ? JSON.parse(saved) : INITIAL_VENUES;
  });

  const [visits, setVisits] = useState(() => {
    const saved = localStorage.getItem('shava_visits_v2');
    return saved ? JSON.parse(saved) : INITIAL_VISITS;
  });

  const [members] = useState(INITIAL_MEMBERS);

  // Состояние приложения
  const [currentUser, setCurrentUser] = useState(INITIAL_MEMBERS[0]);
  const [isPublicMode, setIsPublicMode] = useState(false);
  const [activeTab, setActiveTab] = useState('dashboard'); // dashboard | tuesdays | comparison | profile

  // Фильтры и категории для главная/рейтинги
  const [rankingCategory, setRankingCategory] = useState('overall'); // overall | shawarma | beer | venue | anti | controversial | visited
  const [filterCity, setFilterCity] = useState('All');
  const [searchQuery, setSearchQuery] = useState('');
  const [minRatingsFilter, setMinRatingsFilter] = useState(1);

  // Модальные окна
  const [isAddModalOpen, setIsAddModalOpen] = useState(false);
  const [selectedVenueForDetail, setSelectedVenueForDetail] = useState(null);
  const [compareVenues, setCompareVenues] = useState({ v1: '', v2: '' });

  // Синхронизация с localStorage
  useEffect(() => {
    localStorage.setItem('shava_venues_v2', JSON.stringify(venues));
  }, [venues]);

  useEffect(() => {
    localStorage.setItem('shava_visits_v2', JSON.stringify(visits));
  }, [visits]);

  // Агрегация данных и расчета оценок по заведениям
  const venueStats = useMemo(() => {
    return venues.map(venue => {
      const vVisits = visits.filter(v => v.venueId === venue.id);
      let totalShawarma = 0;
      let totalBeer = 0;
      let totalVenue = 0;
      let totalOverall = 0;
      let reviewCount = 0;
      let allScoresArray = [];

      vVisits.forEach(vis => {
        vis.reviews.forEach(rev => {
          const sh = calcCategoryAvg(rev.scores.shawarma);
          const be = calcCategoryAvg(rev.scores.beer);
          const ve = calcCategoryAvg(rev.scores.venue);
          const ov = (sh + be + ve) / 3;

          totalShawarma += sh;
          totalBeer += be;
          totalVenue += ve;
          totalOverall += ov;
          reviewCount++;
          allScoresArray.push(ov);
        });
      });

      const avgShawarma = reviewCount ? totalShawarma / reviewCount : 0;
      const avgBeer = reviewCount ? totalBeer / reviewCount : 0;
      const avgVenue = reviewCount ? totalVenue / reviewCount : 0;
      const avgOverall = reviewCount ? totalOverall / reviewCount : 0;

      // Расчет среднеквадратичного отклонения для номинации "Спорное место"
      let variance = 0;
      if (reviewCount > 1) {
        const sumSq = allScoresArray.reduce((acc, score) => acc + Math.pow(score - avgOverall, 2), 0);
        variance = Math.sqrt(sumSq / reviewCount);
      }

      return {
        ...venue,
        actualVisitsCount: vVisits.length,
        reviewCount,
        avgShawarma: Number(avgShawarma.toFixed(1)),
        avgBeer: Number(avgBeer.toFixed(1)),
        avgVenue: Number(avgVenue.toFixed(1)),
        avgOverall: Number(avgOverall.toFixed(1)),
        variance: Number(variance.toFixed(2)),
        latestVisitDate: vVisits.length ? vVisits[0].date : venue.lastVisit
      };
    });
  }, [venues, visits]);

  // Список уникальных городов
  const cities = useMemo(() => {
    const set = new Set(venues.map(v => v.city));
    return ['All', ...Array.from(set)];
  }, [venues]);

  // Фильтрация и сортировка заведений для рейтингов
  const sortedVenues = useMemo(() => {
    let result = venueStats.filter(v => {
      const matchCity = filterCity === 'All' || v.city === filterCity;
      const matchSearch = v.name.toLowerCase().includes(searchQuery.toLowerCase()) || 
                          v.address.toLowerCase().includes(searchQuery.toLowerCase());
      const matchMinRatings = v.reviewCount >= minRatingsFilter;
      return matchCity && matchSearch && matchMinRatings;
    });

    switch (rankingCategory) {
      case 'shawarma':
        return result.sort((a, b) => b.avgShawarma - a.avgShawarma);
      case 'beer':
        return result.sort((a, b) => b.avgBeer - a.avgBeer);
      case 'venue':
        return result.sort((a, b) => b.avgVenue - a.avgVenue);
      case 'anti':
        return result.sort((a, b) => a.avgOverall - b.avgOverall);
      case 'controversial':
        return result.sort((a, b) => b.variance - a.variance);
      case 'visited':
        return result.sort((a, b) => b.actualVisitsCount - a.actualVisitsCount);
      case 'overall':
      default:
        return result.sort((a, b) => b.avgOverall - a.avgOverall);
    }
  }, [venueStats, rankingCategory, filterCity, searchQuery, minRatingsFilter]);

  // Номинации «Шава Вторника» и «Пиво Вторника»
  const shawarmaOfWeek = useMemo(() => {
    return [...venueStats].sort((a, b) => b.avgShawarma - a.avgShawarma)[0];
  }, [venueStats]);

  const beerOfWeek = useMemo(() => {
    return [...venueStats].sort((a, b) => b.avgBeer - a.avgBeer)[0];
  }, [venueStats]);

  // Общее количество оценок
  const totalRatingsGiven = useMemo(() => {
    return visits.reduce((acc, vis) => acc + vis.reviews.length, 0);
  }, [visits]);

  // Последний рейд
  const latestVisit = useMemo(() => {
    if (!visits.length) return null;
    return [...visits].sort((a, b) => new Date(b.date) - new Date(a.date))[0];
  }, [visits]);

  // Форма добавления нового рейда / заведения
  const [formData, setFormData] = useState({
    venueMode: 'existing', // existing | new
    existingVenueId: venues[0]?.id || '',
    newVenueName: '',
    newVenueCity: 'Минск',
    newVenueAddress: '',
    newVenuePhoto: 'https://images.unsplash.com/photo-1561758033-d89a9ad46330?w=800&auto=format&fit=crop&q=80',
    date: new Date().toISOString().split('T')[0],
    title: 'Очередной рейд вторника',
    orderedShawarma: '',
    orderedBeer: '',
    priceBYN: '15.00',
    photoUrl: 'https://images.unsplash.com/photo-1626700051175-6818013e1d4f?w=600&auto=format&fit=crop&q=80',
    comment: '',
    scores: {
      shawarma: { taste: 8, meat: 8, sauce: 8, lavash: 8, priceQuality: 8 },
      beer: { taste: 8, aroma: 8, aftertaste: 8, temp: 8, priceQuality: 8 },
      venue: { atmosphere: 8, cleanliness: 8, service: 8, comfort: 8, overall: 8 }
    }
  });

  const handleCreateVisit = (e) => {
    e.preventDefault();
    if (isPublicMode) return;

    let targetVenueId = formData.existingVenueId;

    if (formData.venueMode === 'new') {
      const newV = {
        id: 'v-' + Date.now(),
        name: formData.newVenueName || 'Новое заведение',
        city: formData.newVenueCity,
        address: formData.newVenueAddress || 'Центральный район',
        photo: formData.newVenuePhoto,
        visitCount: 1,
        lastVisit: formData.date,
        priceAvgBYN: parseFloat(formData.priceBYN) || 15.00
      };
      setVenues(prev => [newV, ...prev]);
      targetVenueId = newV.id;
    }

    const newVisitObj = {
      id: 'vis-' + Date.now(),
      venueId: targetVenueId,
      date: formData.date,
      title: formData.title,
      orderedShawarma: formData.orderedShawarma || 'Шаурма фирменная',
      orderedBeer: formData.orderedBeer || 'Пиво крафтовое',
      photos: [formData.photoUrl],
      reviews: [
        {
          memberId: currentUser.id,
          comment: formData.comment || 'Оценка выставлена во время вторничного рейда.',
          scores: formData.scores
        }
      ]
    };

    setVisits(prev => [newVisitObj, ...prev]);
    setIsAddModalOpen(false);
  };

  const handleScoreChange = (cat, field, val) => {
    setFormData(prev => ({
      ...prev,
      scores: {
        ...prev.scores,
        [cat]: {
          ...prev.scores[cat],
          [field]: Number(val)
        }
      }
    }));
  };

  return (
    <div className="min-h-screen bg-[#0F291E] text-[#FDFBF7] font-sans flex flex-col selection:bg-[#F97316] selection:text-white">
      
      {/* --- ШАПКА / HEADER --- */}
      <header className="border-b border-[#1A4332] bg-[#0A1D15] sticky top-0 z-40 shadow-xl backdrop-blur-md bg-opacity-95">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-col sm:flex-row items-center justify-between gap-4">
          
          {/* Логотип */}
          <div className="flex items-center gap-3 cursor-pointer" onClick={() => setActiveTab('dashboard')}>
            <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-[#F97316] to-[#FB923C] flex items-center justify-center shadow-lg shadow-[#F97316]/30 transform -rotate-3">
              <Flame className="w-6 h-6 text-white animate-pulse" />
            </div>
            <div>
              <div className="flex items-center gap-2">
                <h1 className="text-2xl font-black tracking-wider text-white font-mono uppercase">
                  ШАВА<span className="text-[#F97316]">ЛИГА</span>
                </h1>
                <span className="text-[10px] bg-[#F97316]/20 text-[#F97316] border border-[#F97316]/40 px-2 py-0.5 rounded font-bold uppercase tracking-widest">
                  CLUB
                </span>
              </div>
              <p className="text-xs text-[#FDFBF7]/60 italic">«Каждый вторник — новая проверка»</p>
            </div>
          </div>

          {/* Навигация */}
          <nav className="flex items-center gap-1 sm:gap-2 bg-[#143D2B]/80 p-1.5 rounded-2xl border border-[#1A4332] text-xs sm:text-sm font-medium overflow-x-auto max-w-full">
            <button
              onClick={() => setActiveTab('dashboard')}
              className={`px-3.5 py-2 rounded-xl transition flex items-center gap-1.5 whitespace-nowrap ${
                activeTab === 'dashboard' ? 'bg-[#F97316] text-white shadow-md font-bold' : 'text-[#FDFBF7]/80 hover:text-white hover:bg-[#1A4332]'
              }`}
            >
              <Trophy className="w-4 h-4" /> Главная & Рейтинги
            </button>
            <button
              onClick={() => setActiveTab('tuesdays')}
              className={`px-3.5 py-2 rounded-xl transition flex items-center gap-1.5 whitespace-nowrap ${
                activeTab === 'tuesdays' ? 'bg-[#F97316] text-white shadow-md font-bold' : 'text-[#FDFBF7]/80 hover:text-white hover:bg-[#1A4332]'
              }`}
            >
              <Calendar className="w-4 h-4" /> Наши Вторники
            </button>
            <button
              onClick={() => setActiveTab('comparison')}
              className={`px-3.5 py-2 rounded-xl transition flex items-center gap-1.5 whitespace-nowrap ${
                activeTab === 'comparison' ? 'bg-[#F97316] text-white shadow-md font-bold' : 'text-[#FDFBF7]/80 hover:text-white hover:bg-[#1A4332]'
              }`}
            >
