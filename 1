                  value={compareVenues.v1}
                  onChange={(e) => setCompareVenues(prev => ({ ...prev, v1: e.target.value }))}
                  className="w-full bg-[#0F291E] text-xs text-white p-2.5 rounded-xl border border-[#1A4332] focus:outline-none"
                >
                  <option value="">Выберите заведение 1...</option>
                  {venueStats.map(v => (
                    <option key={v.id} value={v.id}>{v.name} ({v.city})</option>
                  ))}
                </select>
              </div>

              <div>
                <label className="text-xs text-[#FDFBF7]/70 block mb-1">Второе заведение:</label>
                <select
                  value={compareVenues.v2}
                  onChange={(e) => setCompareVenues(prev => ({ ...prev, v2: e.target.value }))}
                  className="w-full bg-[#0F291E] text-xs text-white p-2.5 rounded-xl border border-[#1A4332] focus:outline-none"
                >
                  <option value="">Выберите заведение 2...</option>
                  {venueStats.map(v => (
                    <option key={v.id} value={v.id}>{v.name} ({v.city})</option>
                  ))}
                </select>
              </div>
            </div>

            {/* Сравнительная таблица */}
            {compareVenues.v1 && compareVenues.v2 ? (
              (() => {
                const venueA = venueStats.find(v => v.id === compareVenues.v1);
                const venueB = venueStats.find(v => v.id === compareVenues.v2);

                if (!venueA || !venueB) return null;

                const comparisonMetrics = [
                  { label: 'Общий средний балл', keyA: venueA.avgOverall, keyB: venueB.avgOverall },
                  { label: 'Оценка Шавермы', keyA: venueA.avgShawarma, keyB: venueB.avgShawarma },
                  { label: 'Оценка Пива', keyA: venueA.avgBeer, keyB: venueB.avgBeer },
                  { label: 'Оценка Заведения / Атмосферы', keyA: venueA.avgVenue, keyB: venueB.avgVenue },
                  { label: 'Средний чек', keyA: `${venueA.priceAvgBYN} BYN`, keyB: `${venueB.priceAvgBYN} BYN` },
                  { label: 'Количество рейдов', keyA: venueA.actualVisitsCount, keyB: venueB.actualVisitsCount }
                ];

                return (
                  <div className="bg-[#143D2B]/60 rounded-2xl border border-[#1A4332] overflow-hidden p-6">
                    <div className="grid grid-cols-3 text-center border-b border-[#1A4332] pb-4 font-bold text-sm">
                      <div className="text-[#F97316]">{venueA.name}</div>
                      <div className="text-[#FDFBF7]/40">Критерий</div>
                      <div className="text-amber-400">{venueB.name}</div>
                    </div>

                    <div className="divide-y divide-[#1A4332]">
                      {comparisonMetrics.map((m, idx) => (
                        <div key={idx} className="grid grid-cols-3 text-center py-3.5 text-xs">
                          <div className="font-bold text-white text-sm">{m.keyA}</div>
                          <div className="text-[#FDFBF7]/60 flex items-center justify-center">{m.label}</div>
                          <div className="font-bold text-white text-sm">{m.keyB}</div>
                        </div>
                      ))}
                    </div>
                  </div>
                );
              })()
            ) : (
              <div className="text-center py-12 bg-[#143D2B]/30 rounded-2xl border border-dashed border-[#1A4332] text-xs text-[#FDFBF7]/50">
                Выберите два заведения выше для построения дуэли показателей.
              </div>
            )}
          </div>
        )}

        {/* --- РАЗДЕЛ 4: ЛИЧНЫЙ КАБИНЕТ УЧАСТНИКА --- */}
        {activeTab === 'profile' && (
          <div className="space-y-6">
            <div className="bg-[#143D2B]/80 p-6 rounded-2xl border border-[#1A4332] flex flex-col md:flex-row items-center gap-6">
              <img 
                src={currentUser.avatar} 
                alt={currentUser.name} 
                className="w-24 h-24 rounded-2xl object-cover border-2 border-[#F97316] shadow-xl"
              />
              <div className="text-center md:text-left flex-1">
                <span className="text-xs font-bold text-[#F97316] uppercase tracking-widest bg-[#F97316]/10 px-2.5 py-1 rounded border border-[#F97316]/30">
                  {currentUser.role}
                </span>
                <h3 className="text-2xl font-black text-white mt-2">{currentUser.name}</h3>
                <p className="text-xs text-[#FDFBF7]/70 mt-1">Официальный инспектор и участник рейдов клуба «ШаваЛига»</p>
              </div>

              <div className="bg-[#0F291E] p-4 rounded-xl border border-[#1A4332] text-center min-w-[150px]">
                <div className="text-2xl font-black text-amber-400">{currentUser.strictness} / 10</div>
                <div className="text-[10px] text-[#FDFBF7]/60 uppercase mt-1">Строгость оценивания</div>
              </div>
            </div>

            {/* Карточки личной статистики */}
            <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
              <div className="bg-[#143D2B]/40 p-5 rounded-2xl border border-[#1A4332]">
                <div className="text-xs text-[#FDFBF7]/60 uppercase font-bold">Оценивал заведений</div>
                <div className="text-3xl font-black text-white mt-2">
                  {visits.filter(v => v.reviews.some(r => r.memberId === currentUser.id)).length}
                </div>
              </div>

              <div className="bg-[#143D2B]/40 p-5 rounded-2xl border border-[#1A4332]">
                <div className="text-xs text-[#FDFBF7]/60 uppercase font-bold flex items-center gap-1">
                  <Heart className="w-3.5 h-3.5 text-[#F97316]" /> Любимое заведение
                </div>
                <div className="text-base font-bold text-[#F97316] mt-2">
                  {currentUser.favVenue}
                </div>
              </div>

              <div className="bg-[#143D2B]/40 p-5 rounded-2xl border border-[#1A4332]">
                <div className="text-xs text-[#FDFBF7]/60 uppercase font-bold flex items-center gap-1">
                  <Beer className="w-3.5 h-3.5 text-amber-400" /> Статус эксперта
                </div>
                <div className="text-base font-bold text-amber-400 mt-2">
                  Активный вторничный рейдер
                </div>
              </div>
            </div>
          </div>
        )}

      </main>

      {/* --- МОДАЛЬНОЕ ОКНО: ДЕТАЛИ ЗАВЕДЕНИЯ --- */}
      {selectedVenueForDetail && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
          <div className="bg-[#0F291E] border border-[#1A4332] w-full max-w-2xl rounded-3xl overflow-hidden shadow-2xl relative my-8">
            <button
              onClick={() => setSelectedVenueForDetail(null)}
              className="absolute top-4 right-4 bg-black/60 hover:bg-black text-white w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold z-10 cursor-pointer"
            >
              ✕
            </button>

            <div className="relative h-56">
              <img src={selectedVenueForDetail.photo} alt={selectedVenueForDetail.name} className="w-full h-full object-cover" />
              <div className="absolute inset-0 bg-gradient-to-t from-[#0F291E] via-transparent to-transparent" />
              <div className="absolute bottom-4 left-6">
                <span className="text-xs bg-[#F97316] text-white font-bold px-2.5 py-1 rounded-md">
                  {selectedVenueForDetail.city}
                </span>
                <h3 className="text-2xl font-black text-white mt-1">{selectedVenueForDetail.name}</h3>
                <p className="text-xs text-[#FDFBF7]/70">{selectedVenueForDetail.address}</p>
              </div>
            </div>

            <div className="p-6 space-y-6">
              {/* Баллы */}
              <div className="grid grid-cols-4 gap-3 text-center bg-[#143D2B] p-4 rounded-2xl border border-[#1A4332]">
                <div>
                  <div className="text-[10px] text-[#FDFBF7]/60 uppercase">Общий</div>
                  <div className="text-lg font-black text-white">{selectedVenueForDetail.avgOverall}</div>
                </div>
                <div>
                  <div className="text-[10px] text-[#FDFBF7]/60 uppercase">Шава</div>
                  <div className="text-lg font-black text-[#F97316]">{selectedVenueForDetail.avgShawarma}</div>
                </div>
                <div>
                  <div className="text-[10px] text-[#FDFBF7]/60 uppercase">Пиво</div>
                  <div className="text-lg font-black text-amber-400">{selectedVenueForDetail.avgBeer}</div>
                </div>
                <div>
                  <div className="text-[10px] text-[#FDFBF7]/60 uppercase">Вайб</div>
                  <div className="text-lg font-black text-emerald-400">{selectedVenueForDetail.avgVenue}</div>
                </div>
              </div>

              <div className="flex justify-between items-center text-xs text-[#FDFBF7]/70 border-b border-[#1A4332] pb-4">
                <span>Средний чек: <strong className="text-white">{selectedVenueForDetail.priceAvgBYN} BYN</strong></span>
                <span>Количество рейдов: <strong className="text-white">{selectedVenueForDetail.actualVisitsCount}</strong></span>
              </div>

              <div className="text-center pt-2">
                <button
                  onClick={() => setSelectedVenueForDetail(null)}
                  className="bg-[#143D2B] hover:bg-[#1A4332] text-white text-xs font-bold px-6 py-2.5 rounded-xl border border-[#1A4332] cursor-pointer"
                >
                  Закрыть окно
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* --- МОДАЛЬНОЕ ОКНО: ОЦЕНИТЬ ВТОРНИЧНЫЙ РЕЙД --- */}
      {isAddModalOpen && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 overflow-y-auto">
          <div className="bg-[#0F291E] border border-[#1A4332] w-full max-w-3xl rounded-3xl overflow-hidden shadow-2xl relative my-8 max-h-[90vh] flex flex-col">
            
            {/* Шапка формы */}
            <div className="p-6 border-b border-[#143D2B] flex items-center justify-between">
              <div>
                <h3 className="text-xl font-black text-white flex items-center gap-2">
                  <Flame className="w-5 h-5 text-[#F97316]" /> Оценить вторничный рейд
                </h3>
                <p className="text-xs text-[#FDFBF7]/60">Выставляются оценки от лица: <strong>{currentUser.name}</strong></p>
              </div>
              <button
                onClick={() => setIsAddModalOpen(false)}
                className="text-[#FDFBF7]/50 hover:text-white font-bold text-lg cursor-pointer"
              >
                ✕
              </button>
            </div>

            {/* Форма с прокруткой */}
            <form onSubmit={handleCreateVisit} className="p-6 overflow-y-auto space-y-6 flex-1 text-xs">
              
              {/* Раздел 1: Выбор или добавление заведения */}
              <div className="space-y-3">
                <label className="font-bold text-white uppercase tracking-wider text-[11px] block">1. Заведение</label>
                <div className="flex gap-4">
                  <label className="flex items-center gap-2 cursor-pointer">
                    <input 
                      type="radio" 
                      name="vMode" 
                      checked={formData.venueMode === 'existing'} 
                      onChange={() => setFormData(prev => ({ ...prev, venueMode: 'existing' }))}
                    />
                    <span>Существующее</span>
                  </label>
                  <label className="flex items-center gap-2 cursor-pointer">
                    <input 
                      type="radio" 
                      name="vMode" 
                      checked={formData.venueMode === 'new'} 
                      onChange={() => setFormData(prev => ({ ...prev, venueMode: 'new' }))}
                    />
                    <span>Добавить новое</span>
                  </label>
                </div>

                {formData.venueMode === 'existing' ? (
                  <select
                    value={formData.existingVenueId}
                    onChange={(e) => setFormData(prev => ({ ...prev, existingVenueId: e.target.value }))}
                    className="w-full bg-[#143D2B] text-white p-3 rounded-xl border border-[#1A4332]"
                  >
                    {venues.map(v => (
                      <option key={v.id} value={v.id}>{v.name} ({v.city}, {v.address})</option>
                    ))}
                  </select>
                ) : (
                  <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <input 
                      type="text" 
                      placeholder="Название (напр. Шава&Craft)" 
                      value={formData.newVenueName}
                      onChange={(e) => setFormData(prev => ({ ...prev, newVenueName: e.target.value }))}
                      className="bg-[#143D2B] text-white p-3 rounded-xl border border-[#1A4332]"
                      required
                    />
                    <input 
                      type="text" 
                      placeholder="Город (Минск, Гродно)" 
                      value={formData.newVenueCity}
                      onChange={(e) => setFormData(prev => ({ ...prev, newVenueCity: e.target.value }))}
                      className="bg-[#143D2B] text-white p-3 rounded-xl border border-[#1A4332]"
                      required
                    />
                    <input 
                      type="text" 
                      placeholder="Адрес" 
                      value={formData.newVenueAddress}
                      onChange={(e) => setFormData(prev => ({ ...prev, newVenueAddress: e.target.value }))}
                      className="bg-[#143D2B] text-white p-3 rounded-xl border border-[#1A4332]"
                      required
                    />
                  </div>
                )}
              </div>

              {/* Детали заказа */}
              <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                  <label className="text-[#FDFBF7]/70 block mb-1">Дата посещения</label>
                  <input 
                    type="date" 
                    value={formData.date}
                    onChange={(e) => setFormData(prev => ({ ...prev, date: e.target.value }))}
                    className="w-full bg-[#143D2B] text-white p-2.5 rounded-xl border border-[#1A4332]"
                  />
                </div>
                <div>
                  <label className="text-[#FDFBF7]/70 block mb-1">Что брали из Шаурмы</label>
                  <input 
                    type="text" 
                    placeholder="Например: Сырная с халапеньо" 
                    value={formData.orderedShawarma}
                    onChange={(e) => setFormData(prev => ({ ...prev, orderedShawarma: e.target.value }))}
                    className="w-full bg-[#143D2B] text-white p-2.5 rounded-xl border border-[#1A4332]"
                  />
                </div>
                <div>
                  <label className="text-[#FDFBF7]/70 block mb-1">Что пили</label>
                  <input 
                    type="text" 
                    placeholder="Например: IPA 0.5л" 
                    value={formData.orderedBeer}
                    onChange={(e) => setFormData(prev => ({ ...prev, orderedBeer: e.target.value }))}
                    className="w-full bg-[#143D2B] text-white p-2.5 rounded-xl border border-[#1A4332]"
                  />
                </div>
              </div>

              {/* РАЗДОЛ 2: КРИТЕРИИ ШАВЕРМЫ */}
              <div className="bg-[#143D2B]/50 p-4 rounded-2xl border border-[#1A4332] space-y-3">
                <h4 className="font-bold text-[#F97316] uppercase flex items-center gap-1.5">
                  <Flame className="w-4 h-4" /> 2. Критерии Шавермы (1 - 10)
                </h4>
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  {[
                    { id: 'taste', label: 'Вкус и общее впечатление' },
                    { id: 'meat', label: 'Качество мяса' },
                    { id: 'sauce', label: 'Соус' },
                    { id: 'lavash', label: 'Лаваш / Хруст' },
                    { id: 'priceQuality', label: 'Цена / Качество' }
                  ].map(item => (
                    <div key={item.id}>
                      <div className="flex justify-between text-[#FDFBF7]/80 mb-1">
                        <span>{item.label}</span>
                        <span className="font-bold text-white">{formData.scores.shawarma[item.id]}</span>
                      </div>
                      <input 
                        type="range" 
                        min="1" 
                        max="10" 
                        value={formData.scores.shawarma[item.id]}
                        onChange={(e) => handleScoreChange('shawarma', item.id, e.target.value)}
                        className="w-full accent-[#F97316]"
                      />
                    </div>
                  ))}
                </div>
              </div>

              {/* РАЗДЕЛ 3: КРИТЕРИИ ПИВА */}
              <div className="bg-[#143D2B]/50 p-4 rounded-2xl border border-[#1A4332] space-y-3">
                <h4 className="font-bold text-amber-400 uppercase flex items-center gap-1.5">
                  <Beer className="w-4 h-4" /> 3. Критерии Пива (1 - 10)
                </h4>
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  {[
                    { id: 'taste', label: 'Вкус' },
                    { id: 'aroma', label: 'Аромат' },
                    { id: 'aftertaste', label: 'Послевкусие' },
                    { id: 'temp', label: 'Температура подачи' },
                    { id: 'priceQuality', label: 'Соотношение цены' }
                  ].map(item => (
                    <div key={item.id}>
                      <div className="flex justify-between text-[#FDFBF7]/80 mb-1">
                        <span>{item.label}</span>
                        <span className="font-bold text-white">{formData.scores.beer[item.id]}</span>
                      </div>
                      <input 
                        type="range" 
                        min="1" 
                        max="10" 
                        value={formData.scores.beer[item.id]}
                        onChange={(e) => handleScoreChange('beer', item.id, e.target.value)}
                        className="w-full accent-amber-500"
                      />
                    </div>
                  ))}
                </div>
              </div>

              {/* РАЗДЕЛ 4: КРИТЕРИИ ЗАВЕДЕНИЯ */}
              <div className="bg-[#143D2B]/50 p-4 rounded-2xl border border-[#1A4332] space-y-3">
                <h4 className="font-bold text-emerald-400 uppercase flex items-center gap-1.5">
                  <Trophy className="w-4 h-4" /> 4. Атмосфера и сервис (1 - 10)
                </h4>
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  {[
                    { id: 'atmosphere', label: 'Атмосфера' },
                    { id: 'cleanliness', label: 'Чистота' },
                    { id: 'service', label: 'Обслуживание' },
                    { id: 'comfort', label: 'Комфорт' },
                    { id: 'overall', label: 'Общий вайб' }
                  ].map(item => (
                    <div key={item.id}>
                      <div className="flex justify-between text-[#FDFBF7]/80 mb-1">
                        <span>{item.label}</span>
                        <span className="font-bold text-white">{formData.scores.venue[item.id]}</span>
                      </div>
                      <input 
                        type="range" 
                        min="1" 
                        max="10" 
                        value={formData.scores.venue[item.id]}
                        onChange={(e) => handleScoreChange('venue', item.id, e.target.value)}
                        className="w-full accent-emerald-500"
                      />
                    </div>
                  ))}
                </div>
              </div>

              {/* Текстовый комментарий */}
              <div>
                <label className="text-[#FDFBF7]/70 block mb-1">Вердикт эксперта (комментарий)</label>
                <textarea
                  rows="3"
                  placeholder="Опишите ваши впечатления от соусов, лаваша и атмосферы..."
                  value={formData.comment}
                  onChange={(e) => setFormData(prev => ({ ...prev, comment: e.target.value }))}
                  className="w-full bg-[#143D2B] text-white p-3 rounded-xl border border-[#1A4332]"
                />
              </div>

              {/* Отправка */}
              <div className="pt-2">
                <button
                  type="submit"
                  className="w-full bg-gradient-to-r from-[#F97316] to-[#FB923C] text-white py-3.5 rounded-xl font-bold text-sm shadow-xl shadow-[#F97316]/30 cursor-pointer"
                >
                  Опубликовать оценку рейда
                </button>
              </div>

            </form>

          </div>
        </div>
      )}

      {/* --- ПОДВАЛ / FOOTER --- */}
      <footer className="bg-[#0A1D15] border-t border-[#1A4332] py-6 text-center text-xs text-[#FDFBF7]/40">
        <div className="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row justify-between items-center gap-4">
          <div>
            © 2026 <strong>ШАВАЛИГА</strong>. Независимый рейтинг шавермы и пива.
          </div>
          <div className="flex items-center gap-4">
            <span>Валюта: BYN</span>
            <span>Минск • Гродно • Могилев</span>
          </div>
        </div>
      </footer>

    </div>
  );
}
